# =====================================================================
# NEXUS AI — variáveis de ambiente (copie para .env.local; NUNCA commite valores reais)
# =====================================================================

# --- Banco de dados (PostgreSQL / Supabase) ---------------------------
# URL usada pela APLICAÇÃO: usuário membro de "nexus_app" (sujeito a RLS).
# Crie com: npx tsx scripts/create-app-db-user.ts
DATABASE_URL=postgres://nexus_app_user:SENHA@localhost:5432/nexus
# URL usada SOMENTE para migrações (papel dono das tabelas, ex.: "postgres" no Supabase).
DATABASE_MIGRATION_URL=postgres://nexus_owner:SENHA@localhost:5432/nexus

# --- Segurança ---------------------------------------------------------
# Chave de 32 bytes em base64 para criptografar credenciais (AES-256-GCM).
# Gere com: openssl rand -base64 32   — perder esta chave = perder as credenciais salvas.
ENCRYPTION_KEY=
# URL pública do app (links de recuperação de senha, callbacks OAuth, webhooks).
APP_URL=http://localhost:3000
# Segredo exigido pela rota /api/cron/worker (agendador externo). Gere com openssl rand -hex 32.
CRON_SECRET=

# --- Provedores de IA (chaves da PLATAFORMA; opcionais) ----------------
# Também podem ser cadastradas pelo painel (ficam criptografadas no banco).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- E-mail transacional (recuperação de senha, notificações) ---------
# Provedor Resend (https://resend.com). Sem isto, o envio fica PENDENTE.
RESEND_API_KEY=
EMAIL_FROM="NEXUS AI <nao-responda@seudominio.com.br>"

# --- Pesquisa na internet (ferramenta web_search) ---------------------
# Provedor Tavily (https://tavily.com). Sem isto, a ferramenta fica PENDENTE.
TAVILY_API_KEY=

# --- Google (Gmail, Calendar, Sheets, Drive) — OAuth -------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# --- Google Maps (Places API) -----------------------------------------
GOOGLE_MAPS_API_KEY=

# --- WhatsApp Business (Cloud API da Meta) ----------------------------
# Token de verificação do webhook (você escolhe) e App Secret para validar assinaturas.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Pagamentos (desativados até configurar e testar) ------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
