{
  "name": "nexus-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NEXUS AI — plataforma SaaS de agentes de inteligência artificial personalizados",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate && node scripts/sync-netlify-migrations.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed-demo": "tsx --conditions=react-server scripts/seed-demo.ts",
    "worker": "tsx --conditions=react-server scripts/worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run.mjs",
    "db:sync-netlify": "node scripts/sync-netlify-migrations.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@netlify/database": "^2.0.4",
    "@node-rs/argon2": "^2.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.80.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.6",
    "openai": "^7.64.0",
    "papaparse": "^5.7.1",
    "pdf-parse": "^2.4.5",
    "postgres": "^4.1.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.10",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "opentype.js": "^1.3.4",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2"
  }
}
